# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection String
# 1. Sign up / Log into MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# 2. Create a Free M0 Cluster
# 3. Create a Database User (Username & Password)
# 4. Under Network Access, allow IP Address (0.0.0.0/0 for anywhere)
# 5. Click "Connect" -> "Drivers" -> Copy the connection string and paste below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/queue_db?retryWrites=true&w=majority

# Optional: Render Deploy Hook URL for GitHub Actions auto-trigger
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxx?key=yyyyyy
